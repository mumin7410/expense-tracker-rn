{
  "expo": {
    "name": "สลิปสรุป",
    "slug": "expense-tracker-rn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f6fa",
    "android": {
      "package": "com.slipsummary.app",
      "adaptiveIcon": {
        "backgroundColor": "#d2ddff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "ให้เลือกรูปสลิปจากคลังภาพเพื่ออ่านยอดและวันที่"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f6fa",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ExpenseWidget",
              "label": "สลิปสรุป",
              "description": "ยอดรวมเดือนนี้และจำนวนที่รอจัดหมวด",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-notification-icon.js",
      "./plugins/with-notifee-maven.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
