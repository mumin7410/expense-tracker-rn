# Copy to .env and fill in. Everything prefixed EXPO_PUBLIC_ is inlined into the
# JS bundle at build time, so treat all of it as readable by anyone with the APK.

# Supabase project (Singapore). Settings -> API in the dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://nzmmwbspbuggfbnvjvuj.supabase.co

# The anon key is designed to ship inside the app; Row Level Security is what
# keeps one user's rows away from another. NEVER put the service_role key here —
# it bypasses RLS entirely, and anyone who unzips the APK can read every user.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OCR service. No VPS yet, so point this at the dev machine:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
# --host 0.0.0.0 is required, otherwise nothing off the machine can reach it.
#
# Android emulator: use 10.0.2.2, its alias for the host's loopback. It goes
# through the emulator's NAT rather than the network, so no firewall rule is
# needed.
#
# Real device: use the machine's LAN IP. That also needs an inbound firewall
# rule for TCP 8000 — Windows matches rules by program path, so an existing
# rule for a system Python does NOT cover a venv's python.exe, and the symptom
# is that localhost works while every other device is refused.
#
# A deployed service must be https://. A release build blocks cleartext http://
# outright — it only ever worked in development because the debug manifest sets
# usesCleartextTraffic, and nothing warns you when the release APK stops.
EXPO_PUBLIC_OCR_BASE_URL=http://10.0.2.2:8000

# Must match API_KEY on the OCR service. Leave empty against a local service
# that has none. Inlined into the bundle like every EXPO_PUBLIC_ value, so treat
# it as readable by anyone holding the APK: it keeps scanners off a public host,
# it does not identify the user.
EXPO_PUBLIC_OCR_API_KEY=
